#!/usr/bin/env bash
#MISE description = "Test core and owned object-ID capabilities independently"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
cargo test --locked -p trogon_object_id --no-default-features
for feature in serde uuid macros macros,serde macros,uuid macros,serde,uuid alloc alloc,serde alloc,uuid alloc,macros alloc,macros,serde alloc,macros,uuid uuid-generate template template,serde template,macros template,macros,serde alloc,template,macros,serde; do
  cargo test --locked -p trogon_object_id --no-default-features --features "$feature"
done
cargo test --locked -p trogon_object_id --all-features
cargo test --locked -p trogon_object_id --all-features --release --test allocation_tests
rustup target add wasm32-unknown-unknown
consumer=crates/trogon_object_id/tests/portability_consumer/Cargo.toml
for feature in '' derive encoding binary derive,encoding,binary owned owned,derive,encoding,binary; do
  cargo test --locked --manifest-path "$consumer" --lib --no-default-features --features "$feature"
done
cargo build --locked --manifest-path "$consumer" --target wasm32-unknown-unknown --no-default-features
cargo build --locked --manifest-path "$consumer" --target wasm32-unknown-unknown --no-default-features --features derive,encoding,binary
cargo build --locked --manifest-path "$consumer" --target wasm32-unknown-unknown --no-default-features --features owned,derive,encoding,binary
tree=$(cargo tree --locked --manifest-path "$consumer" --no-default-features --features derive,encoding,binary --edges normal,no-proc-macro --format '{p} features=[{f}]')
printf '%s\n' "$tree"
if printf '%s\n' "$tree" | grep -E 'features=\[[^]]*(std|alloc|rng|getrandom|v4|v7)|getrandom v'; then
  echo 'core-only consumer enabled an owned or platform capability' >&2
  exit 1
fi
cargo test --locked -p trogon_uuid --release --test allocation_tests
recipes=crates/trogon_uuid/tests/portability_consumer/Cargo.toml
cargo test --locked --manifest-path "$recipes" --lib
cargo build --locked --manifest-path "$recipes" --target wasm32-unknown-unknown
tree=$(cargo tree --locked --manifest-path "$recipes" --edges normal,no-proc-macro --format '{p} features=[{f}]')
printf '%s\n' "$tree"
if printf '%s\n' "$tree" | grep -E 'features=\[[^]]*(std|alloc|rng|getrandom|v4|v7)|getrandom v'; then
  echo 'deterministic UUID runtime enabled an owned or platform capability' >&2
  exit 1
fi
generated=crates/trogon_uuid_build/tests/portability_consumer/Cargo.toml
cargo test --locked --manifest-path "$generated" --lib
cargo build --locked --manifest-path "$generated" --target wasm32-unknown-unknown
tree=$(cargo tree --locked --manifest-path "$generated" --edges normal,no-proc-macro --format '{p} features=[{f}]')
printf '%s\n' "$tree"
if printf '%s\n' "$tree" | grep -E 'features=\[[^]]*(std|alloc|rng|getrandom|v4|v7)|getrandom v'; then
  echo 'generated target code enabled an owned or platform capability' >&2
  exit 1
fi
cargo test --locked -p uuid_identity_example --release --test allocation_tests
templates=crates/trogon_object_id/tests/template_consumer/Cargo.toml
cargo test --locked --manifest-path "$templates" --lib --features encoding
cargo build --locked --manifest-path "$templates" --target wasm32-unknown-unknown --features encoding
tree=$(cargo tree --locked --manifest-path "$templates" --features encoding --edges normal,no-proc-macro --format '{p} features=[{f}]')
printf '%s\n' "$tree"
if printf '%s\n' "$tree" | grep -E 'features=\[[^]]*(std|alloc|rng|getrandom|v4|v7)|getrandom v'; then
  echo 'typed template target enabled an owned or platform capability' >&2
  exit 1
fi
