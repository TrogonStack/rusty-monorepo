#!/usr/bin/env bash
#MISE description = "Run the policy lint rules across every workspace feature and target"
#MISE depends = ["lints:build"]
set -euo pipefail
source "${MISE_PROJECT_ROOT:?}/.config/mise/lib/lints.sh"
cd "${MISE_PROJECT_ROOT:?}"
lib="$(lints_library)"
test -f "$lib"
dylint_bin="$(mise where cargo:cargo-dylint)/bin/cargo-dylint"
lints_exec "$dylint_bin" dylint \
  --lib-path "$lib" --workspace --no-deps -- --locked --all-features --all-targets --keep-going
