#!/usr/bin/env bash
#MISE description = "Start the OpenBao test service"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
docker run -d --name openbao \
  --cap-add=IPC_LOCK \
  -p 8200:8200 \
  -e BAO_DEV_ROOT_TOKEN_ID=trg-ci-root \
  -e BAO_DEV_LISTEN_ADDRESS=0.0.0.0:8200 \
  openbao/openbao@sha256:597f62847dd382382056a1d6704d50465908c2040038c4611832a23269a67112 \
  server -dev -dev-no-store-token
for _ in $(seq 1 30); do
  if curl -sf http://127.0.0.1:8200/v1/sys/health > /dev/null; then
    exit 0
  fi
  sleep 1
done
echo "OpenBao did not come up" >&2
docker logs openbao >&2
exit 1
