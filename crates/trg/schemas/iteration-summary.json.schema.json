{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trogonstack.dev/schemas/trg/iteration-summary.json.schema.json",
  "title": "trg skills eval iteration summary",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "iteration",
    "generated_at",
    "failed_runs_mode",
    "always_pass",
    "always_fail",
    "helped_by_skill",
    "flaky_assertions",
    "timing_outliers",
    "token_outliers"
  ],
  "properties": {
    "schema_version": {
      "const": "trg.skills-eval.iteration-summary.v1"
    },
    "report_id": { "type": "string" },
    "iteration": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string" },
    "failed_runs_mode": {
      "enum": ["bucket", "exclude", "zero"]
    },
    "always_pass": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion_stability_record" }
    },
    "always_fail": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion_stability_record" }
    },
    "helped_by_skill": {
      "type": "array",
      "items": { "$ref": "#/$defs/helped_by_skill_record" }
    },
    "flaky_assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/flaky_assertion_record" }
    },
    "timing_outliers": {
      "type": "array",
      "items": { "$ref": "#/$defs/timing_outlier_record" }
    },
    "token_outliers": {
      "type": "array",
      "items": { "$ref": "#/$defs/token_outlier_record" }
    },
    "cross_iteration": { "$ref": "#/$defs/cross_iteration_section" }
  },
  "additionalProperties": true,
  "$defs": {
    "cross_iteration_delta": {
      "enum": ["new", "stable", "lost"]
    },
    "assertion_stability_record": {
      "type": "object",
      "required": ["eval_id", "assertion_text", "attempts_observed"],
      "properties": {
        "eval_id": { "type": "string" },
        "assertion_text": { "type": "string" },
        "attempts_observed": { "type": "integer", "minimum": 1 },
        "cross_iteration_delta": { "$ref": "#/$defs/cross_iteration_delta" }
      },
      "additionalProperties": true
    },
    "helped_by_skill_record": {
      "type": "object",
      "required": [
        "eval_id",
        "assertion_text",
        "with_skill_pass_rate",
        "without_skill_pass_rate",
        "delta"
      ],
      "properties": {
        "eval_id": { "type": "string" },
        "assertion_text": { "type": "string" },
        "with_skill_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "without_skill_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "delta": { "type": "number" }
      },
      "additionalProperties": true
    },
    "flaky_assertion_record": {
      "type": "object",
      "required": [
        "eval_id",
        "scenario",
        "assertion_text",
        "attempts",
        "pass_count",
        "flakiness_ratio"
      ],
      "properties": {
        "eval_id": { "type": "string" },
        "scenario": { "type": "string" },
        "assertion_text": { "type": "string" },
        "attempts": { "type": "integer", "minimum": 2 },
        "pass_count": { "type": "integer", "minimum": 0 },
        "flakiness_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "timing_outlier_record": {
      "type": "object",
      "required": [
        "eval_id",
        "scenario",
        "attempt",
        "duration_ms",
        "mean_ms",
        "stddev_ms"
      ],
      "properties": {
        "eval_id": { "type": "string" },
        "scenario": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "mean_ms": { "type": "number", "minimum": 0 },
        "stddev_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "token_outlier_record": {
      "type": "object",
      "required": [
        "eval_id",
        "scenario",
        "attempt",
        "total_tokens",
        "mean_tokens",
        "stddev_tokens"
      ],
      "properties": {
        "eval_id": { "type": "string" },
        "scenario": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "mean_tokens": { "type": "number", "minimum": 0 },
        "stddev_tokens": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "cross_iteration_section": {
      "type": "object",
      "required": [
        "previous_report_id",
        "previous_iteration",
        "newly_always_pass",
        "no_longer_always_pass",
        "newly_always_fail",
        "no_longer_always_fail"
      ],
      "properties": {
        "previous_report_id": { "type": "string" },
        "previous_iteration": { "type": "integer", "minimum": 1 },
        "newly_always_pass": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion_stability_record" }
        },
        "no_longer_always_pass": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion_stability_record" }
        },
        "newly_always_fail": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion_stability_record" }
        },
        "no_longer_always_fail": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion_stability_record" }
        }
      },
      "additionalProperties": true
    }
  }
}
