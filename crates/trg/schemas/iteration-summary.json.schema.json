{
  "$defs": {
    "AssertionStabilityRecord": {
      "properties": {
        "assertion": {
          "type": "string"
        },
        "attempts_observed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cross_iteration_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossIterationDelta"
            },
            {
              "type": "null"
            }
          ]
        },
        "eval_case_id": {
          "type": "string"
        }
      },
      "required": [
        "eval_case_id",
        "assertion",
        "attempts_observed"
      ],
      "type": "object"
    },
    "CrossIterationDelta": {
      "enum": [
        "new",
        "stable",
        "lost"
      ],
      "type": "string"
    },
    "CrossIterationSection": {
      "properties": {
        "newly_always_fail": {
          "items": {
            "$ref": "#/$defs/AssertionStabilityRecord"
          },
          "type": "array"
        },
        "newly_always_pass": {
          "items": {
            "$ref": "#/$defs/AssertionStabilityRecord"
          },
          "type": "array"
        },
        "no_longer_always_fail": {
          "items": {
            "$ref": "#/$defs/AssertionStabilityRecord"
          },
          "type": "array"
        },
        "no_longer_always_pass": {
          "items": {
            "$ref": "#/$defs/AssertionStabilityRecord"
          },
          "type": "array"
        },
        "previous_iteration": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "previous_report_id": {
          "type": "string"
        }
      },
      "required": [
        "previous_report_id",
        "previous_iteration",
        "newly_always_pass",
        "no_longer_always_pass",
        "newly_always_fail",
        "no_longer_always_fail"
      ],
      "type": "object"
    },
    "FailedRunsMode": {
      "enum": [
        "bucket",
        "exclude",
        "zero"
      ],
      "type": "string"
    },
    "FlakinessRatio": {
      "description": "The share of a key's attempts that did not pass, in `0.0..=1.0`.\n\nA share rather than a count, because one flip out of twelve and six out of twelve are\nthe same verdict and very different findings.",
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "FlakyAssertionRecord": {
      "description": "What every artifact publishes about a flaky assertion.",
      "properties": {
        "assertion": {
          "type": "string"
        },
        "attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "flakiness_ratio": {
          "$ref": "#/$defs/FlakinessRatio"
        },
        "pass_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "eval_case_id",
        "scenario_id",
        "assertion",
        "attempts",
        "pass_count",
        "flakiness_ratio"
      ],
      "type": "object"
    },
    "HelpedBySkillRecord": {
      "description": "`delta` is a subtraction between two pass rates, each already a ratio over its own\narm's attempts. Nothing about `with_skill_pass_rate` or `without_skill_pass_rate`\nsays whether that ratio was drawn from three attempts or thirty, so the attempt\ncounts ride alongside it rather than being left for a reader to assume.",
      "properties": {
        "assertion": {
          "type": "string"
        },
        "delta": {
          "format": "double",
          "type": "number"
        },
        "eval_case_id": {
          "type": "string"
        },
        "with_skill_attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "with_skill_pass_rate": {
          "format": "double",
          "type": "number"
        },
        "without_skill_attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "without_skill_pass_rate": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "eval_case_id",
        "assertion",
        "with_skill_pass_rate",
        "without_skill_pass_rate",
        "delta",
        "with_skill_attempts",
        "without_skill_attempts"
      ],
      "type": "object"
    },
    "Interval": {
      "description": "The range a measurement is consistent with.",
      "properties": {
        "high": {
          "format": "double",
          "type": "number"
        },
        "low": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "type": "object"
    },
    "KeepOrRevertSection": {
      "properties": {
        "by_split": {
          "additionalProperties": false,
          "description": "Empty when `suites` is `different_suites`, since a verdict across two different\nsuites is not a verdict about the change.",
          "properties": {
            "test": {
              "$ref": "#/$defs/SplitVerdict"
            },
            "train": {
              "$ref": "#/$defs/SplitVerdict"
            }
          },
          "type": "object"
        },
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "suites": {
          "$ref": "#/$defs/SuiteComparison"
        }
      },
      "required": [
        "suites",
        "by_split",
        "recommendation"
      ],
      "type": "object"
    },
    "Recommendation": {
      "description": "What the two verdicts above say to do with the change under review.",
      "oneOf": [
        {
          "const": "keep",
          "description": "The held-out split improved: the change generalized past the cases it was tuned on.",
          "type": "string"
        },
        {
          "const": "revert",
          "description": "The held-out split regressed: the change made the skill worse where it counts.",
          "type": "string"
        },
        {
          "const": "suspected_overfitting",
          "description": "Train improved while test did not, which is what a skill that learned the suite\ninstead of the task looks like.",
          "type": "string"
        },
        {
          "const": "inconclusive",
          "description": "Neither split moved far enough to say either way, or the suites being compared are\nnot the same suite.",
          "type": "string"
        }
      ]
    },
    "SplitDelta": {
      "description": "The `with_skill` assertion and run pass-rate change between this iteration and the\nprevious one, and the 95% intervals around each. The assertion pass rate drives the\nverdict this rides alongside: it pools every scored assertion rather than collapsing a\ncase with three assertions and one with one assertion to the same single vote a run\npass rate would give them, so it moves on the same evidence the reviewer's bundle does.",
      "properties": {
        "assertion_pass_rate_delta": {
          "format": "double",
          "type": "number"
        },
        "assertion_pass_rate_delta_interval": {
          "$ref": "#/$defs/Interval"
        },
        "run_pass_rate_delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "run_pass_rate_delta_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assertion_pass_rate_delta",
        "assertion_pass_rate_delta_interval"
      ],
      "type": "object"
    },
    "SplitSummary": {
      "properties": {
        "always_fail": {
          "items": {
            "$ref": "#/$defs/AssertionStabilityRecord"
          },
          "type": "array"
        },
        "always_pass": {
          "items": {
            "$ref": "#/$defs/AssertionStabilityRecord"
          },
          "type": "array"
        },
        "helped_by_skill": {
          "items": {
            "$ref": "#/$defs/HelpedBySkillRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "always_pass",
        "always_fail",
        "helped_by_skill"
      ],
      "type": "object"
    },
    "SplitVerdict": {
      "description": "The verdict for one split's `with_skill` delta against the previous iteration, derived\nfrom whether `assertion_pass_rate_delta_interval` excludes zero.",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/SplitDelta"
            }
          ],
          "description": "The interval sits entirely above zero: this split's `with_skill` arm did better.",
          "properties": {
            "status": {
              "const": "improved",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SplitDelta"
            }
          ],
          "description": "The interval sits entirely below zero: this split's `with_skill` arm did worse.",
          "properties": {
            "status": {
              "const": "regressed",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SplitDelta"
            }
          ],
          "description": "The interval straddles zero: the change has not beaten this split's own noise.",
          "properties": {
            "status": {
              "const": "indistinguishable",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "description": "Neither iteration scored a `with_skill` run on this split, so there is nothing to\ncompare. Never treated as `Indistinguishable`: silence about a split is not a\nfinding about it.",
          "properties": {
            "status": {
              "const": "no_runs",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "SuiteComparison": {
      "description": "Whether the eval suite is the same one the previous iteration ran, which the\nkeep-or-revert verdict below depends on: a pass-rate change against a suite that\ngained or lost cases is not a change in the skill.",
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "same_suite",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "current_suite_hash": {
              "type": "string"
            },
            "previous_suite_hash": {
              "type": "string"
            },
            "status": {
              "const": "different_suites",
              "type": "string"
            }
          },
          "required": [
            "status",
            "current_suite_hash",
            "previous_suite_hash"
          ],
          "type": "object"
        }
      ]
    },
    "TimingOutlierRecord": {
      "properties": {
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "mad_ms": {
          "format": "double",
          "type": "number"
        },
        "median_ms": {
          "format": "double",
          "type": "number"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "eval_case_id",
        "scenario_id",
        "attempt",
        "duration_ms",
        "median_ms",
        "mad_ms"
      ],
      "type": "object"
    },
    "TokenOutlierRecord": {
      "properties": {
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "mad_tokens": {
          "format": "double",
          "type": "number"
        },
        "median_tokens": {
          "format": "double",
          "type": "number"
        },
        "scenario_id": {
          "type": "string"
        },
        "total_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "eval_case_id",
        "scenario_id",
        "attempt",
        "total_tokens",
        "median_tokens",
        "mad_tokens"
      ],
      "type": "object"
    }
  },
  "$id": "https://trogonstack.dev/schemas/trg/iteration-summary.json.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "always_fail": {
      "items": {
        "$ref": "#/$defs/AssertionStabilityRecord"
      },
      "type": "array"
    },
    "always_pass": {
      "items": {
        "$ref": "#/$defs/AssertionStabilityRecord"
      },
      "type": "array"
    },
    "by_split": {
      "additionalProperties": false,
      "description": "The same assertion stability and with-skill-vs-without-skill records, narrowed to\neach split, so a train gain and a flat test result sit side by side with the\noverall numbers above.",
      "properties": {
        "test": {
          "$ref": "#/$defs/SplitSummary"
        },
        "train": {
          "$ref": "#/$defs/SplitSummary"
        }
      },
      "type": "object"
    },
    "cross_iteration": {
      "anyOf": [
        {
          "$ref": "#/$defs/CrossIterationSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "failed_runs_mode": {
      "$ref": "#/$defs/FailedRunsMode"
    },
    "flaky_assertions": {
      "items": {
        "$ref": "#/$defs/FlakyAssertionRecord"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "helped_by_skill": {
      "items": {
        "$ref": "#/$defs/HelpedBySkillRecord"
      },
      "type": "array"
    },
    "iteration": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "keep_or_revert": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeepOrRevertSection"
        },
        {
          "type": "null"
        }
      ],
      "description": "Whether this iteration's `with_skill` arm beat the previous iteration's on each\nsplit, and what that says about keeping or reverting the change. Absent when there\nis no previous iteration to compare against."
    },
    "report_id": {
      "type": "string"
    },
    "timing_outliers": {
      "items": {
        "$ref": "#/$defs/TimingOutlierRecord"
      },
      "type": "array"
    },
    "token_outliers": {
      "items": {
        "$ref": "#/$defs/TokenOutlierRecord"
      },
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "iteration",
    "generated_at",
    "failed_runs_mode",
    "always_pass",
    "always_fail",
    "helped_by_skill",
    "flaky_assertions",
    "timing_outliers",
    "token_outliers",
    "by_split"
  ],
  "title": "trg skills eval iteration summary",
  "type": "object"
}
