{
  "$defs": {
    "ArmObservations": {
      "description": "What one side of a `ScenarioDelta` drew.\n\n`runs` is always available and always means something, so it is always published.\nA spread is not: duration is the only metric here still carrying its raw per-run\nvalues at the point a delta is built, so it is the only one that can honestly offer\none, and only once the arm clears the floor `Dispersion` needs to describe itself.\nPass rates and cost are already pooled sums by then, with no per-draw distribution\nleft to measure.",
      "properties": {
        "duration_mad_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "duration_median_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "runs"
      ],
      "type": "object"
    },
    "AttemptPassRateStats": {
      "properties": {
        "max": {
          "format": "double",
          "type": "number"
        },
        "mean": {
          "format": "double",
          "type": "number"
        },
        "min": {
          "format": "double",
          "type": "number"
        },
        "variance": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "mean",
        "min",
        "max"
      ],
      "type": "object"
    },
    "BucketCost": {
      "description": "What the runs behind one bucket cost, or why nobody can say.\n\nA plain total said nothing about how much of its bucket it covered, so a bucket of ten\nruns where one carried a price published that one run's price as the bucket's cost.\nSaying which of the two a total is what makes it readable at all.",
      "oneOf": [
        {
          "description": "Every run in this bucket carried a price, so this total is the bucket's cost.",
          "properties": {
            "kind": {
              "const": "whole",
              "type": "string"
            },
            "usd": {
              "format": "double",
              "minimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "usd"
          ],
          "type": "object"
        },
        {
          "description": "Only some of the bucket's runs carried a price. `runs` is how many, so nobody\nreads the total as the whole bucket's.",
          "properties": {
            "kind": {
              "const": "partial",
              "type": "string"
            },
            "runs": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "usd": {
              "format": "double",
              "minimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "usd",
            "runs"
          ],
          "type": "object"
        },
        {
          "description": "At least one run here came from a harness that prices nothing, so this bucket has\nno total at all rather than a total that quietly leaves those runs out.",
          "properties": {
            "harness": {
              "type": "string"
            },
            "kind": {
              "const": "unpriced",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "harness"
          ],
          "type": "object"
        }
      ]
    },
    "CompletedBucket": {
      "properties": {
        "assertions": {
          "$ref": "#/$defs/PassFailSummary"
        },
        "duration_ms": {
          "$ref": "#/$defs/DurationStats"
        },
        "missing_grading": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing_timing": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "run_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "runs": {
          "$ref": "#/$defs/PassFailSummary"
        },
        "tokens": {
          "$ref": "#/$defs/TokenStats"
        }
      },
      "required": [
        "run_count",
        "assertions",
        "runs",
        "duration_ms",
        "tokens",
        "missing_grading",
        "missing_timing"
      ],
      "type": "object"
    },
    "DurationStats": {
      "properties": {
        "mad": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "format": "double",
          "type": "number"
        },
        "median": {
          "description": "Present once the draws clear `SampleFloor::dispersion()`; a group any smaller has\nnothing to measure its own spread against.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "p50": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p95": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stddev": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mean",
        "p50",
        "p95",
        "total"
      ],
      "type": "object"
    },
    "EvalScenarioAttemptRow": {
      "properties": {
        "attempt_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "flaky_assertions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pass_rate": {
          "$ref": "#/$defs/AttemptPassRateStats"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "eval_case_id",
        "scenario_id",
        "attempt_count",
        "pass_rate"
      ],
      "type": "object"
    },
    "EvalSuiteDriftWarning": {
      "properties": {
        "added_eval_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "current_hash": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "previous_hash": {
          "type": "string"
        },
        "removed_eval_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "current_hash",
        "previous_hash",
        "added_eval_ids",
        "removed_eval_ids"
      ],
      "type": "object"
    },
    "FailedRunsMode": {
      "enum": [
        "bucket",
        "exclude",
        "zero"
      ],
      "type": "string"
    },
    "FlakinessRatio": {
      "description": "The share of a key's attempts that did not pass, in `0.0..=1.0`.\n\nA share rather than a count, because one flip out of twelve and six out of twelve are\nthe same verdict and very different findings.",
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "FlakyAssertionRecord": {
      "description": "What every artifact publishes about a flaky assertion.",
      "properties": {
        "assertion": {
          "type": "string"
        },
        "attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "flakiness_ratio": {
          "$ref": "#/$defs/FlakinessRatio"
        },
        "pass_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "eval_case_id",
        "scenario_id",
        "assertion",
        "attempts",
        "pass_count",
        "flakiness_ratio"
      ],
      "type": "object"
    },
    "Interval": {
      "description": "The range a measurement is consistent with.",
      "properties": {
        "high": {
          "format": "double",
          "type": "number"
        },
        "low": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "type": "object"
    },
    "IterationComparison": {
      "properties": {
        "by_scenario": {
          "additionalProperties": {
            "$ref": "#/$defs/ScenarioDelta"
          },
          "type": "object"
        },
        "current_iteration_id": {
          "type": "string"
        },
        "previous_iteration_id": {
          "type": "string"
        }
      },
      "required": [
        "current_iteration_id",
        "previous_iteration_id",
        "by_scenario"
      ],
      "type": "object"
    },
    "IterationSummary": {
      "properties": {
        "always_fail": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "always_pass": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "flaky_assertions": {
          "items": {
            "$ref": "#/$defs/FlakyAssertionRecord"
          },
          "type": "array"
        },
        "helped_by_skill": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timing_outliers": {
          "items": {
            "$ref": "#/$defs/MetricOutlier"
          },
          "type": "array"
        },
        "token_outliers": {
          "items": {
            "$ref": "#/$defs/MetricOutlier"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "MetricOutlier": {
      "properties": {
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "mad": {
          "format": "double",
          "type": "number"
        },
        "median": {
          "format": "double",
          "type": "number"
        },
        "run_id": {
          "type": "string"
        },
        "scenario_id": {
          "type": "string"
        },
        "value": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "eval_case_id",
        "scenario_id",
        "attempt",
        "value",
        "median",
        "mad"
      ],
      "type": "object"
    },
    "PassFailSummary": {
      "properties": {
        "failed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pass_rate": {
          "format": "double",
          "type": "number"
        },
        "passed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "total",
        "pass_rate"
      ],
      "type": "object"
    },
    "RunBucketSummary": {
      "properties": {
        "duration_ms": {
          "$ref": "#/$defs/DurationStats"
        },
        "missing_timing": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "run_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "$ref": "#/$defs/TokenStats"
        }
      },
      "required": [
        "run_count",
        "duration_ms",
        "tokens",
        "missing_timing"
      ],
      "type": "object"
    },
    "ScenarioBenchmark": {
      "properties": {
        "completed": {
          "$ref": "#/$defs/CompletedBucket"
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunBucketSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "$ref": "#/$defs/SkippedBucket"
        }
      },
      "required": [
        "completed",
        "skipped"
      ],
      "type": "object"
    },
    "ScenarioDelta": {
      "description": "A subtraction between two arms, with what stood behind each side of it.\n\nThree draws is the default depth of a cell, and a scenario pools several cells\ntogether, so the runs behind an arm are rarely the twelve or twenty a reader might\nassume a benchmark implies. A delta without `left`/`right` published next to it asks\nthe reader to trust a rounding of two small, unlabeled counts as if it were a finding.",
      "properties": {
        "assertion_pass_rate": {
          "format": "double",
          "type": "number"
        },
        "assertion_pass_rate_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "description": "The 95% interval the draws behind both arms leave around `assertion_pass_rate`.\nAn interval that contains zero means these arms have not been told apart, however\nlarge the subtraction above it looks."
        },
        "cost_usd": {
          "description": "Published only when both arms priced every run behind them, because a difference\nbetween two totals that cover different numbers of runs is not a cost difference.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "duration_ms_mean": {
          "format": "double",
          "type": "number"
        },
        "left": {
          "$ref": "#/$defs/ArmObservations"
        },
        "right": {
          "$ref": "#/$defs/ArmObservations"
        },
        "run_pass_rate": {
          "format": "double",
          "type": "number"
        },
        "run_pass_rate_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "description": "The 95% interval around `run_pass_rate`, read the same way."
        },
        "tokens_total": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "assertion_pass_rate",
        "run_pass_rate",
        "duration_ms_mean",
        "left",
        "right"
      ],
      "type": "object"
    },
    "ScenarioDeltas": {
      "properties": {
        "with_skill_vs_old_skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioDelta"
            },
            {
              "type": "null"
            }
          ]
        },
        "with_skill_vs_without_skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioDelta"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "SchemaVersion": {
      "description": "Which shape of this artifact the document was written to. Absent means it predates stamping, which is shape 1.",
      "maximum": 4294967295,
      "minimum": 1,
      "type": "integer"
    },
    "SkippedBucket": {
      "properties": {
        "run_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "run_count"
      ],
      "type": "object"
    },
    "TokenStats": {
      "description": "The shape a bucket's tokens are written in, which is the shape every earlier release\nstill reads. `cost_usd` was that release's whole vocabulary for cost, and it was read\nas the bucket's cost, so it is published for exactly the buckets whose total is that:\na partial total under that name is the reading this field was changed to stop.",
      "properties": {
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/BucketCost"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "description": "The bucket's cost alone, for readers written before `cost` could say what a total\ncovers. Published only for a bucket every run of which was priced.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "input": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://trogonstack.dev/schemas/trg/benchmark.json.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "by_eval_scenario": {
      "items": {
        "$ref": "#/$defs/EvalScenarioAttemptRow"
      },
      "type": "array"
    },
    "deltas": {
      "$ref": "#/$defs/ScenarioDeltas"
    },
    "failed_runs_mode": {
      "$ref": "#/$defs/FailedRunsMode"
    },
    "generated_at": {
      "type": "string"
    },
    "iteration_comparison": {
      "anyOf": [
        {
          "$ref": "#/$defs/IterationComparison"
        },
        {
          "type": "null"
        }
      ]
    },
    "iteration_summary": {
      "$ref": "#/$defs/IterationSummary"
    },
    "report_id": {
      "type": "string"
    },
    "scenarios": {
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioBenchmark"
      },
      "type": "object"
    },
    "schema_version": {
      "allOf": [
        {
          "$ref": "#/$defs/SchemaVersion"
        }
      ],
      "default": 1
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/EvalSuiteDriftWarning"
      },
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "generated_at",
    "failed_runs_mode",
    "scenarios",
    "deltas",
    "iteration_summary"
  ],
  "title": "trg skills eval benchmark",
  "type": "object"
}
