{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trogonstack.dev/schemas/trg/report.json.schema.json",
  "title": "trg skills eval report",
  "type": "object",
  "required": [
    "schema_version",
    "report",
    "suite",
    "dimensions",
    "runs",
    "assertion_results",
    "summaries",
    "comparisons"
  ],
  "properties": {
    "schema_version": {
      "const": "trg.skills-eval.report.v1"
    },
    "report": { "$ref": "#/$defs/report_section" },
    "suite": { "$ref": "#/$defs/suite_section" },
    "dimensions": { "$ref": "#/$defs/dimensions_section" },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run_record" }
    },
    "assertion_results": {
      "type": "array",
      "items": { "type": "object" }
    },
    "summaries": { "$ref": "#/$defs/summaries_section" },
    "improvement_feedback": {
      "type": "array",
      "items": { "$ref": "#/$defs/improvement_feedback_record" }
    },
    "comparisons": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "scenario_kind": {
      "enum": ["with_skill", "without_skill", "old_skill"]
    },
    "report_section": {
      "type": "object",
      "required": ["id", "generated_at", "iteration", "producer"],
      "properties": {
        "id": { "type": "string" },
        "generated_at": { "type": "string" },
        "iteration": { "type": "integer", "minimum": 1 },
        "producer": { "$ref": "#/$defs/producer_section" },
        "runner": { "type": "string" },
        "runner_binary": { "type": "string" },
        "runner_version": { "type": "string" },
        "ci": { "$ref": "#/$defs/ci_section" }
      },
      "additionalProperties": true
    },
    "producer_section": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ci_section": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string" },
        "run_id": { "type": "string" },
        "run_attempt": { "type": "string" },
        "workflow": { "type": "string" },
        "job": { "type": "string" },
        "commit": { "type": "string" },
        "git_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "suite_section": {
      "type": "object",
      "required": [
        "skill_name",
        "skill_path",
        "skill_hash",
        "evals_path",
        "evals_hash"
      ],
      "properties": {
        "skill_name": { "type": "string" },
        "skill_path": { "type": "string" },
        "skill_hash": { "type": "string" },
        "evals_path": { "type": "string" },
        "evals_hash": { "type": "string" },
        "old_skill_path": { "type": "string" },
        "old_skill_hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dimensions_section": {
      "type": "object",
      "required": [
        "eval_cases",
        "assertions",
        "skill_revisions",
        "model_configs",
        "scenarios",
        "graders"
      ],
      "properties": {
        "eval_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/eval_case_dimension" }
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion_dimension" }
        },
        "skill_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/skill_revision_dimension" }
        },
        "model_configs": {
          "type": "array",
          "items": { "$ref": "#/$defs/model_config_dimension" }
        },
        "scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/scenario_dimension" }
        },
        "graders": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "eval_case_dimension": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "prompt",
        "expected_output",
        "files",
        "assertion_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "prompt": { "type": "string" },
        "expected_output": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assertion_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "assertion_dimension": {
      "type": "object",
      "required": ["id", "eval_case_id", "text"],
      "properties": {
        "id": { "type": "string" },
        "eval_case_id": { "type": "string" },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "skill_revision_dimension": {
      "type": "object",
      "required": ["id", "skill_hash"],
      "properties": {
        "id": { "type": "string" },
        "skill_hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "model_config_dimension": {
      "type": "object",
      "required": [
        "id",
        "capture_status",
        "label",
        "parameters",
        "parameter_sources",
        "extra"
      ],
      "properties": {
        "id": { "type": "string" },
        "capture_status": { "type": "string" },
        "label": { "type": "string" },
        "parameters": { "type": "object" },
        "parameter_sources": { "type": "object" },
        "extra": { "type": "object" }
      },
      "additionalProperties": true
    },
    "scenario_dimension": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/scenario_kind" },
        "kind": { "$ref": "#/$defs/scenario_kind" }
      },
      "additionalProperties": true
    },
    "run_record": {
      "type": "object",
      "required": [
        "id",
        "eval_case_id",
        "eval_slug",
        "scenario_id",
        "iteration",
        "model_config_id",
        "skill_revision_id",
        "attempt",
        "status",
        "paths",
        "mirror_path",
        "artifacts",
        "metrics"
      ],
      "properties": {
        "id": { "type": "string" },
        "eval_case_id": { "type": "string" },
        "eval_slug": { "type": "string" },
        "scenario_id": { "$ref": "#/$defs/scenario_kind" },
        "iteration": { "type": "integer", "minimum": 1 },
        "model_config_id": { "type": "string" },
        "skill_revision_id": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "paths": { "$ref": "#/$defs/run_paths" },
        "mirror_path": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": { "type": "object" }
        },
        "metrics": { "$ref": "#/$defs/run_metrics" },
        "cache": {
          "anyOf": [{ "type": "object" }, { "type": "null" }]
        },
        "skill_integrity": {
          "anyOf": [
            { "$ref": "#/$defs/skill_integrity_report" },
            { "type": "null" }
          ]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "run_paths": {
      "type": "object",
      "required": ["workspace", "outputs"],
      "properties": {
        "workspace": { "type": "string" },
        "outputs": { "type": "string" }
      },
      "additionalProperties": true
    },
    "run_metrics": {
      "type": "object",
      "properties": {
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "skill_integrity_report": {
      "type": "object",
      "required": ["tampered", "tampered_files"],
      "properties": {
        "tampered": { "type": "boolean" },
        "tampered_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "summaries_section": {
      "type": "object",
      "required": ["by_scenario"],
      "properties": {
        "by_scenario": {
          "type": "array",
          "items": { "$ref": "#/$defs/scenario_summary" }
        },
        "human_feedback": { "$ref": "#/$defs/human_feedback_summary" }
      },
      "additionalProperties": true
    },
    "scenario_summary": {
      "type": "object",
      "required": [
        "scenario_id",
        "total_runs",
        "passed_runs",
        "skipped_runs",
        "failed_runs"
      ],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/scenario_kind" },
        "total_runs": { "type": "integer", "minimum": 0 },
        "passed_runs": { "type": "integer", "minimum": 0 },
        "skipped_runs": { "type": "integer", "minimum": 0 },
        "failed_runs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "human_feedback_summary": {
      "type": "object",
      "required": [
        "total_runs",
        "reviewed_runs",
        "pending_runs",
        "by_severity",
        "by_category"
      ],
      "properties": {
        "total_runs": { "type": "integer", "minimum": 0 },
        "reviewed_runs": { "type": "integer", "minimum": 0 },
        "pending_runs": { "type": "integer", "minimum": 0 },
        "by_severity": { "$ref": "#/$defs/feedback_count_by_severity" },
        "by_category": { "$ref": "#/$defs/feedback_count_by_category" }
      },
      "additionalProperties": true
    },
    "feedback_count_by_severity": {
      "type": "object",
      "properties": {
        "info": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "blocker": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "feedback_count_by_category": {
      "type": "object",
      "properties": {
        "correctness": { "type": "integer", "minimum": 0 },
        "style": { "type": "integer", "minimum": 0 },
        "completeness": { "type": "integer", "minimum": 0 },
        "other": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "improvement_feedback_record": {
      "type": "object",
      "required": [
        "run_id",
        "eval_case_id",
        "scenario_id",
        "reviewer",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "eval_case_id": { "type": "string" },
        "scenario_id": { "$ref": "#/$defs/scenario_kind" },
        "reviewer": { "type": "string" },
        "reviewed_at": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/feedback_note" }
        }
      },
      "additionalProperties": false
    },
    "feedback_note": {
      "type": "object",
      "required": ["severity", "category", "text"],
      "properties": {
        "severity": {
          "enum": ["info", "warning", "blocker"]
        },
        "category": {
          "enum": ["correctness", "style", "completeness", "other"]
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
