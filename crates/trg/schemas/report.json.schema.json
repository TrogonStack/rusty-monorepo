{
  "$defs": {
    "AssertionDimension": {
      "properties": {
        "eval_case_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "eval_case_id",
        "text"
      ],
      "type": "object"
    },
    "BudgetReport": {
      "description": "What a pass spent against its ceiling.\n\nAbsent when the pass was given no runner at all, since nothing could have been spent\nand no ceiling could have bound it. Present whenever the pass was given one, including\na pass every run of which was served from cache: that pass really did cost nothing, and\na reader tracking spend wants to read the zero rather than watch the section come and\ngo with the state of a cache. Present, with `ceiling_usd` absent, when a runner ran\nwithout `--max-cost-usd`: there was nothing to be admitted against, but a reader still\nwants to know what the pass cost.",
      "properties": {
        "ceiling_usd": {
          "description": "Only ever a finite amount greater than zero, since a ceiling of zero or less could\nadmit nothing and would make the pass unrunnable rather than bounded.",
          "exclusiveMinimum": 0.0,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "exhausted": {
          "type": "boolean"
        },
        "runs_skipped": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "spent": {
          "allOf": [
            {
              "$ref": "#/$defs/PassSpend"
            }
          ],
          "description": "A number only when the harness that ran the pass publishes a price for a run.\nA harness that publishes none leaves a ledger holding zero, and writing that zero\nhere would report a free pass instead of an unpriced one."
        }
      },
      "required": [
        "spent",
        "exhausted",
        "runs_skipped"
      ],
      "type": "object"
    },
    "CacheTokens": {
      "anyOf": [
        {
          "properties": {
            "read_tokens": {
              "type": "integer"
            }
          },
          "required": [
            "read_tokens"
          ]
        },
        {
          "properties": {
            "write_tokens": {
              "type": "integer"
            }
          },
          "required": [
            "write_tokens"
          ]
        }
      ],
      "description": "How many of a run's tokens its harness billed twice over. Absent entirely when the harness never reports cache activity, which is a different claim from a harness that checked and cached nothing. At least one side must be named: a value naming neither carries no information the field being absent does not already carry.",
      "properties": {
        "read_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "write_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CaseSelectionRecord": {
      "description": "The selection a report was produced under, so a reader is not shown partial coverage\nas if it were a pass over the whole suite.",
      "properties": {
        "cases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "covered": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "declared": {
          "description": "Every case ID the suite declared, covered by this run or not.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "covered",
        "declared"
      ],
      "type": "object"
    },
    "CiSection": {
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "job": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        },
        "run_attempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "DimensionsSection": {
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/AssertionDimension"
          },
          "type": "array"
        },
        "eval_cases": {
          "items": {
            "$ref": "#/$defs/EvalCaseDimension"
          },
          "type": "array"
        },
        "grading_strategies": {
          "default": [],
          "description": "The distinct grading strategies actually applied to this report.\n\n`eval grade` can run more than once over the same bundle, a rerun under a\ndifferent judge included, and each distinct strategy is recorded once here. This\nis not the graders an eval case declares in its suite; those show up in\n`assertions` by way of each case's `assertion_ids`.\n\nDefaulted because this field replaced an untyped `graders` list, so every bundle\nwritten before it exists names neither. Reading those as \"no strategy recorded\" is\nthe honest answer, since the old shape carried arbitrary JSON that cannot be\nrecovered as a typed strategy, and it keeps `grade`, `benchmark` and `compare`\nable to open an eval history rather than failing on its first file.",
          "items": {
            "$ref": "#/$defs/GradingStrategy"
          },
          "type": "array"
        },
        "model_configs": {
          "items": {
            "$ref": "#/$defs/ModelConfigDimension"
          },
          "type": "array"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/ScenarioDimension"
          },
          "type": "array"
        },
        "skill_revisions": {
          "items": {
            "$ref": "#/$defs/SkillRevisionDimension"
          },
          "type": "array"
        }
      },
      "required": [
        "eval_cases",
        "assertions",
        "skill_revisions",
        "model_configs",
        "scenarios"
      ],
      "type": "object"
    },
    "EnvironmentPolicy": {
      "description": "How much of the operator's machine a run's harness subprocess is allowed to see.\n\nA run that inherits the operator's environment is not reproducible: the harness picks\nup whatever skills, instructions, MCP servers, and settings happen to be installed for\nthat user, and both arms of a comparison are shifted by them.",
      "oneOf": [
        {
          "const": "inherited",
          "description": "Pass the operator's environment through untouched.",
          "type": "string"
        },
        {
          "const": "scrubbed",
          "description": "Replace the environment with an allowlist, and leave the harness config home alone.",
          "type": "string"
        },
        {
          "const": "isolated",
          "description": "Scrub, and additionally give the run its own `HOME` and harness config home.\n\nThe strongest guarantee, and the default. It needs the harness to be able to\nauthenticate without its host config home, which in practice means credentials\nreachable from the environment or from the auth files linked in for the run.",
          "type": "string"
        }
      ]
    },
    "EvalCaseDimension": {
      "properties": {
        "assertion_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_output": {
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvalPriority"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "prompt",
        "expected_output",
        "files",
        "assertion_ids"
      ],
      "type": "object"
    },
    "EvalDirName": {
      "description": "A single path segment naming the directory, under a skill root, that holds a\nsuite's eval manifest or case directories.\n\nA skill directory is author-supplied, and every reader that wants a suite joins this\nonto one it did not choose. `PathBuf::join` silently discards the base and returns\nthe joined value outright when handed an absolute path, so an unvalidated name here\nwould let a skill's own manifest point `trg` at an arbitrary path on the operator's\nmachine; a name of `..` or containing a separator reaches just as far with smaller\nwords. Restricting this to one plain segment closes all three at the type rather than\nasking every join site to remember why.",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "type": "string"
    },
    "EvalPriority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "ExpectPath": {
      "description": "A dotted path into a tool call's input, e.g. `repo.owner`.",
      "type": "string"
    },
    "FeedbackCategory": {
      "enum": [
        "correctness",
        "style",
        "completeness",
        "other"
      ],
      "type": "string"
    },
    "FeedbackCountByCategory": {
      "properties": {
        "completeness": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "correctness": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "other": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "style": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "correctness",
        "style",
        "completeness",
        "other"
      ],
      "type": "object"
    },
    "FeedbackCountBySeverity": {
      "properties": {
        "blocker": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "info": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "warning": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "info",
        "warning",
        "blocker"
      ],
      "type": "object"
    },
    "FeedbackNote": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/FeedbackCategory"
        },
        "severity": {
          "$ref": "#/$defs/FeedbackSeverity"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "category",
        "text"
      ],
      "type": "object"
    },
    "FeedbackSeverity": {
      "enum": [
        "info",
        "warning",
        "blocker"
      ],
      "type": "string"
    },
    "FlakinessRatio": {
      "description": "The share of a key's attempts that did not pass, in `0.0..=1.0`.\n\nA share rather than a count, because one flip out of twelve and six out of twelve are\nthe same verdict and very different findings.",
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "FlakyAssertionRecord": {
      "description": "What every artifact publishes about a flaky assertion.",
      "properties": {
        "assertion": {
          "type": "string"
        },
        "attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "flakiness_ratio": {
          "$ref": "#/$defs/FlakinessRatio"
        },
        "pass_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "eval_case_id",
        "scenario_id",
        "assertion",
        "attempts",
        "pass_count",
        "flakiness_ratio"
      ],
      "type": "object"
    },
    "GradingStrategy": {
      "description": "One grading strategy that was used to produce the results in this report.",
      "oneOf": [
        {
          "properties": {
            "judge": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JudgeSettings"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mode": {
              "const": "auto",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "properties": {
            "mode": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "description": "The judge a grading pass resolved, when it resolved one.\n\nShared by `Llm`, where a judge is always resolved, and `Auto`, where whether one was\nresolved depends on what the suite declares, so there is one definition of what\n\"which judge\" means rather than a copy living inside each variant.",
          "properties": {
            "mode": {
              "const": "llm",
              "type": "string"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "$ref": "#/$defs/JudgeProvider"
            },
            "votes": {
              "$ref": "#/$defs/JudgeVotes"
            }
          },
          "required": [
            "mode",
            "provider",
            "votes"
          ],
          "type": "object"
        },
        {
          "properties": {
            "command": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "const": "script",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "strict": {
          "description": "Whether the pass that used this strategy rejected an ungradeable assertion\ninstead of recording it as ungraded.",
          "type": "boolean"
        }
      },
      "required": [
        "strict"
      ],
      "type": "object"
    },
    "HumanFeedbackSummary": {
      "properties": {
        "by_category": {
          "$ref": "#/$defs/FeedbackCountByCategory"
        },
        "by_severity": {
          "$ref": "#/$defs/FeedbackCountBySeverity"
        },
        "pending_runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "reviewed_runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total_runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_runs",
        "reviewed_runs",
        "pending_runs",
        "by_severity",
        "by_category"
      ],
      "type": "object"
    },
    "ImprovementFeedbackRecord": {
      "additionalProperties": false,
      "description": "Per-run feedback preserved for future iteration improvement prompts.",
      "properties": {
        "eval_case_id": {
          "type": "string"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/FeedbackNote"
          },
          "type": "array"
        },
        "reviewed_at": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "scenario_id": {
          "$ref": "#/$defs/ScenarioKind"
        }
      },
      "required": [
        "run_id",
        "eval_case_id",
        "scenario_id",
        "reviewer",
        "reviewed_at",
        "notes"
      ],
      "type": "object"
    },
    "IterationSummary": {
      "properties": {
        "always_fail": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "always_pass": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "flaky_assertions": {
          "items": {
            "$ref": "#/$defs/FlakyAssertionRecord"
          },
          "type": "array"
        },
        "helped_by_skill": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timing_outliers": {
          "items": {
            "$ref": "#/$defs/MetricOutlier"
          },
          "type": "array"
        },
        "token_outliers": {
          "items": {
            "$ref": "#/$defs/MetricOutlier"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "JudgeProvider": {
      "oneOf": [
        {
          "enum": [
            "openai",
            "anthropic"
          ],
          "type": "string"
        },
        {
          "const": "compatible",
          "description": "Any endpoint speaking the OpenAI chat-completions protocol, addressed\nthrough `TRG_JUDGE_BASE_URL` and `TRG_JUDGE_API_KEY`.",
          "type": "string"
        }
      ]
    },
    "JudgeSettings": {
      "description": "The judge a grading pass resolved, when it resolved one.\n\nShared by `Llm`, where a judge is always resolved, and `Auto`, where whether one was\nresolved depends on what the suite declares, so there is one definition of what\n\"which judge\" means rather than a copy living inside each variant.",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/JudgeProvider"
        },
        "votes": {
          "$ref": "#/$defs/JudgeVotes"
        }
      },
      "required": [
        "provider",
        "votes"
      ],
      "type": "object"
    },
    "JudgeVotes": {
      "description": "The number of opinions taken on every assertion an LLM judge decides.\n\nAlways odd, because a panel that ties has decided nothing, and reporting a tie as\neither answer would invent the confidence the flag exists to measure.",
      "maximum": 4294967295,
      "minimum": 1,
      "not": {
        "multipleOf": 2
      },
      "type": "integer"
    },
    "MetricOutlier": {
      "properties": {
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "eval_case_id": {
          "type": "string"
        },
        "mad": {
          "format": "double",
          "type": "number"
        },
        "median": {
          "format": "double",
          "type": "number"
        },
        "run_id": {
          "type": "string"
        },
        "scenario_id": {
          "type": "string"
        },
        "value": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "eval_case_id",
        "scenario_id",
        "attempt",
        "value",
        "median",
        "mad"
      ],
      "type": "object"
    },
    "MockViolation": {
      "properties": {
        "constraint": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/ExpectPath"
        },
        "received": {},
        "server": {
          "$ref": "#/$defs/ServerName"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        }
      },
      "required": [
        "server",
        "tool",
        "path",
        "constraint",
        "received"
      ],
      "type": "object"
    },
    "ModelConfigDimension": {
      "properties": {
        "capture_status": {
          "type": "string"
        },
        "extra": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "parameter_sources": {
          "additionalProperties": true,
          "type": "object"
        },
        "parameters": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "id",
        "capture_status",
        "label",
        "parameters",
        "parameter_sources",
        "extra"
      ],
      "type": "object"
    },
    "ModelName": {
      "description": "A harness's own identifier for a model. Not padded with whitespace, and not blank.",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "type": "string"
    },
    "PassSpend": {
      "description": "What a pass spent, or why nobody can say.\n\nA harness that publishes no price leaves a ledger holding zero, and a zero in a spend\nfield reads as a cheap pass rather than an unanswered question. Only a total someone\nactually priced is ever written as a number.",
      "oneOf": [
        {
          "description": "The harness priced its runs, and this is what they came to.",
          "properties": {
            "kind": {
              "const": "priced",
              "type": "string"
            },
            "usd": {
              "format": "double",
              "minimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "usd"
          ],
          "type": "object"
        },
        {
          "description": "The harness reports no price for a run, so this pass has no total to report.",
          "properties": {
            "harness": {
              "type": "string"
            },
            "kind": {
              "const": "unpriced",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "harness"
          ],
          "type": "object"
        }
      ]
    },
    "PermissionOutcome": {
      "description": "A run's requested grant, paired with the grant its harness actually enforced.\n\n`effective` is never narrower than `requested`: a harness can fail to draw as fine a\nboundary as the one asked for, but nothing here models a harness that enforces less\nauthority than it was granted.",
      "enum": [
        "workspace_write",
        "unrestricted",
        {
          "effective": "workspace_write",
          "requested": "workspace_write"
        },
        {
          "effective": "unrestricted",
          "requested": "workspace_write"
        },
        {
          "effective": "unrestricted",
          "requested": "unrestricted"
        }
      ]
    },
    "ProducerSection": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ReportSection": {
      "properties": {
        "allowed_tools": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolGrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/CiSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "allOf": [
            {
              "$ref": "#/$defs/EnvironmentPolicy"
            }
          ],
          "default": "scrubbed",
          "description": "Deliberately does not track `EnvironmentPolicy::default()`. This field was added\nafter the fact, `scrubbed` was the behaviour at the time, and reading a bundle that\nrecorded no policy as the strongest one would claim an isolation guarantee the run\nnever had."
        },
        "generated_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "iteration": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "permission": {
          "allOf": [
            {
              "$ref": "#/$defs/PermissionOutcome"
            }
          ],
          "default": {
            "effective": "workspace_write",
            "requested": "workspace_write"
          }
        },
        "producer": {
          "$ref": "#/$defs/ProducerSection"
        },
        "runner": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_binary": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "generated_at",
        "iteration",
        "producer"
      ],
      "type": "object"
    },
    "RunCacheInfo": {
      "properties": {
        "hit": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "source_run_id": {
          "type": "string"
        }
      },
      "required": [
        "hit",
        "source_run_id",
        "key"
      ],
      "type": "object"
    },
    "RunCost": {
      "description": "What one run cost, or why nobody can say.\n\nA run whose harness prices nothing and a run whose harness prices everything but did\nnot price this one are two different facts, and a bare absent number carries neither.\nA reader totalling an absent price as zero reports a harness as cheap when what it\nactually did was decline to answer.",
      "oneOf": [
        {
          "description": "The harness priced this run, and this is what it came to.",
          "properties": {
            "kind": {
              "const": "priced",
              "type": "string"
            },
            "usd": {
              "format": "double",
              "minimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "usd"
          ],
          "type": "object"
        },
        {
          "description": "The harness prices no run at all, so this one has no cost to report and is not a\nrun that cost nothing. Named, so a report totalling a mixed history can say which\nharness it cannot total.",
          "properties": {
            "harness": {
              "type": "string"
            },
            "kind": {
              "const": "unpriced",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "harness"
          ],
          "type": "object"
        }
      ]
    },
    "RunMetrics": {
      "description": "The shape a run's metrics are written in, which is the shape every earlier release\nstill reads. `cost_usd` was that release's whole vocabulary for cost, so a run that\ncarries a price keeps publishing one; a run nobody priced has no number to put there,\nwhich is what its absence has always meant.",
      "properties": {
        "cached_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheTokens"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunCost"
            },
            {
              "type": "null"
            }
          ],
          "description": "What this run cost, or why nobody can say.\n\nA bare number here could not tell a harness that prices nothing from a harness\nthat priced everything but this run, so a reader totalling a mixed history counted\nthe first as a run that cost nothing."
        },
        "cost_usd": {
          "description": "The price alone, for readers written before `cost` could say why a run carries\nnone. Absent for exactly the runs that carry no price.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "input_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "description": "The tokens every harness agrees to count the same way: input plus output, never a\ncached count folded in. See `cached_tokens` for what each harness billed again.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RunPaths": {
      "properties": {
        "outputs": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "outputs"
      ],
      "type": "object"
    },
    "RunRecord": {
      "properties": {
        "artifacts": {
          "items": {},
          "type": "array"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunCacheInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_score": {
          "description": "This run's own pass rate over its scored assertions, `None` until graded\nor when grading scored nothing. Distinct from any suite-wide pass rate:\na run with a low score here can be hidden inside a suite average that\nstill looks healthy.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "eval_case_id": {
          "type": "string"
        },
        "eval_slug": {
          "type": "string"
        },
        "failure_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "iteration": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "metrics": {
          "$ref": "#/$defs/RunMetrics"
        },
        "mirror_path": {
          "type": "string"
        },
        "mock_violations": {
          "description": "Every `expect` mismatch the mock server logged against a call this run made, read\nback from `mock-calls.jsonl` after the run finished.\n\nA violation never stops the mock from answering the call, so it cannot fail the run\non its own; grading turns each one into an ordinary failing assertion instead. A run\nthat declared no mocks, or violated nothing, serializes exactly as it did before\nthis field existed.",
          "items": {
            "$ref": "#/$defs/MockViolation"
          },
          "type": "array"
        },
        "model_config_id": {
          "type": "string"
        },
        "paths": {
          "$ref": "#/$defs/RunPaths"
        },
        "read_only_fixture_violations": {
          "description": "Read-only fixture paths whose staged copy did not match its source after the run.\n\nKept apart from `skill_integrity` because that field describes the skill directory,\nnot the fixtures staged alongside it, and because grading needs to fail a case over\nthis without also having to interpret a report meant as diagnostic-only.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runner_invocations": {
          "default": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "runner_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelName"
            },
            {
              "type": "null"
            }
          ],
          "description": "The model this run actually executed under, once the case's own choice and the\noperator's `--runner-model` are combined.\n\n`dimensions.model_configs` carries one label for the whole report, so without this a\nreader of a suite where cases pick their own models cannot tell which run used which,\nand would read every run as having used the operator's model."
        },
        "scenario_id": {
          "$ref": "#/$defs/ScenarioKind"
        },
        "skill_integrity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillIntegrityReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "skill_revision_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "tool_grant": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolGrant"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tool grant this run was actually given, once the operator's ceiling and the\ncase's own declaration are combined. `None` means unrestricted."
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "eval_case_id",
        "eval_slug",
        "scenario_id",
        "iteration",
        "model_config_id",
        "skill_revision_id",
        "attempt",
        "status",
        "paths",
        "mirror_path",
        "artifacts",
        "metrics"
      ],
      "type": "object"
    },
    "ScenarioDimension": {
      "properties": {
        "id": {
          "$ref": "#/$defs/ScenarioKind"
        },
        "kind": {
          "$ref": "#/$defs/ScenarioKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "ScenarioKind": {
      "enum": [
        "with_skill",
        "without_skill",
        "old_skill"
      ],
      "type": "string"
    },
    "ScenarioSummary": {
      "properties": {
        "failed_runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "passed_runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "scenario_id": {
          "$ref": "#/$defs/ScenarioKind"
        },
        "skipped_runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total_runs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "scenario_id",
        "total_runs",
        "passed_runs",
        "skipped_runs",
        "failed_runs"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "description": "Which shape of this artifact the document was written to. Absent means it predates stamping, which is shape 1.",
      "maximum": 4294967295,
      "minimum": 1,
      "type": "integer"
    },
    "ServerName": {
      "type": "string"
    },
    "SkillIntegrityReport": {
      "properties": {
        "tampered": {
          "type": "boolean"
        },
        "tampered_files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "tampered",
        "tampered_files"
      ],
      "type": "object"
    },
    "SkillRevisionDimension": {
      "properties": {
        "id": {
          "type": "string"
        },
        "skill_hash": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "skill_hash"
      ],
      "type": "object"
    },
    "SuiteSection": {
      "properties": {
        "case_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseSelectionRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent when the run covered every case the suite declares.\n\n`evals_hash` covers the whole file either way, so without this a narrowed run and a\nfull one are indistinguishable to a reader comparing two reports."
        },
        "eval_dir": {
          "allOf": [
            {
              "$ref": "#/$defs/EvalDirName"
            }
          ],
          "default": "evals",
          "description": "The directory the suite was actually resolved from. Recorded so a later reader\n(grading, next-iteration) can find the same suite this run did without a flag of\nits own; absent on a report written before this field existed, in which case it\nmeans the default."
        },
        "evals_hash": {
          "type": "string"
        },
        "evals_path": {
          "type": "string"
        },
        "old_skill_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_skill_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_hash": {
          "type": "string"
        },
        "skill_name": {
          "type": "string"
        },
        "skill_path": {
          "type": "string"
        }
      },
      "required": [
        "skill_name",
        "skill_path",
        "skill_hash",
        "evals_path",
        "evals_hash"
      ],
      "type": "object"
    },
    "SummariesSection": {
      "properties": {
        "by_scenario": {
          "items": {
            "$ref": "#/$defs/ScenarioSummary"
          },
          "type": "array"
        },
        "human_feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanFeedbackSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "by_scenario"
      ],
      "type": "object"
    },
    "ToolGrant": {
      "description": "A named, finite set of tools a run's harness may use.\n\nNever parsed as empty: naming zero tools is not how an operator or a case denies\nevery gated tool, since a grant with nothing in it reads in a report exactly like a\ngrant nobody declared. [`ToolGrant::narrowed_by`] is the one place an empty set is\nlegitimate, because it answers \"what do both sides admit\", not \"what was declared\".",
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "ToolName": {
      "type": "string"
    }
  },
  "$id": "https://trogonstack.dev/schemas/trg/report.json.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assertion_results": {
      "items": {},
      "type": "array"
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/BudgetReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "comparisons": {
      "items": {},
      "type": "array"
    },
    "dimensions": {
      "$ref": "#/$defs/DimensionsSection"
    },
    "improvement_feedback": {
      "items": {
        "$ref": "#/$defs/ImprovementFeedbackRecord"
      },
      "type": "array"
    },
    "iteration_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/IterationSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "report": {
      "$ref": "#/$defs/ReportSection"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunRecord"
      },
      "type": "array"
    },
    "schema_version": {
      "allOf": [
        {
          "$ref": "#/$defs/SchemaVersion"
        }
      ],
      "default": 1
    },
    "suite": {
      "$ref": "#/$defs/SuiteSection"
    },
    "summaries": {
      "$ref": "#/$defs/SummariesSection"
    }
  },
  "required": [
    "report",
    "suite",
    "dimensions",
    "runs",
    "assertion_results",
    "summaries",
    "comparisons"
  ],
  "title": "trg skills eval report",
  "type": "object"
}
