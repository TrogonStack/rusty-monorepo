{
  "$defs": {
    "AssertionGradeResult": {
      "properties": {
        "assertion": {
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "excluded": {
          "description": "Present when the grader presupposes the skill, so its `passed` value is\nan indicator to read rather than a score to count. Kept out of\n`summary.pass_rate` in both arms, so the gap between them measures the\nwork and not the premise.",
          "type": [
            "string",
            "null"
          ]
        },
        "grader": {
          "$ref": "#/$defs/GraderInfo"
        },
        "passed": {
          "type": "boolean"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "unsupported": {
          "description": "Present when the property cannot be observed on the runner that produced\nthe run. Such a result is neither a pass nor a failure, so it is excluded\nfrom `summary.pass_rate`.",
          "type": [
            "string",
            "null"
          ]
        },
        "votes": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeVoteTally"
            },
            {
              "type": "null"
            }
          ],
          "description": "How a panel of judges split, present only when more than one opinion was taken.\nA single opinion has no split to report, and `passed` already carries it."
        }
      },
      "required": [
        "assertion",
        "passed",
        "evidence",
        "grader"
      ],
      "type": "object"
    },
    "GraderInfo": {
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/GraderKind"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "GraderKind": {
      "enum": [
        "mechanical",
        "declarative",
        "llm",
        "script",
        "needs_llm",
        "none"
      ],
      "type": "string"
    },
    "GradingSummary": {
      "properties": {
        "excluded": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pass_rate": {
          "description": "Over the scored assertions only, so an ungradable property cannot drag a\nskill's score down on a runner that simply cannot be observed. `null` when\nnothing was scored at all, because no assertion answered is not the same\nresult as every assertion failed.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "passed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "total"
      ],
      "type": "object"
    },
    "JudgeVoteTally": {
      "description": "How a panel of judges split on one assertion.\n\nRecorded so a reader can tell an assertion the judge was sure about from one it was\ndivided on. A divided panel is a statement about the assertion, not about the run: it\nsays the material admits both readings, which is a prompt to write the assertion more\nprecisely rather than to go looking at the skill.",
      "properties": {
        "failed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed"
      ],
      "type": "object"
    }
  },
  "$id": "https://trogonstack.dev/schemas/trg/grading.json.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assertion_results": {
      "items": {
        "$ref": "#/$defs/AssertionGradeResult"
      },
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/GradingSummary"
    }
  },
  "required": [
    "assertion_results",
    "summary"
  ],
  "title": "trg skills eval grading",
  "type": "object"
}
