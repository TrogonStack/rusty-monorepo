{
  "$defs": {
    "AssertionGradeResult": {
      "properties": {
        "assertion": {
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "grader": {
          "$ref": "#/$defs/GraderInfo"
        },
        "passed": {
          "type": "boolean"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "unsupported": {
          "description": "Present when the property cannot be observed on the runner that produced\nthe run. Such a result is neither a pass nor a failure, so it is excluded\nfrom `summary.pass_rate`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "assertion",
        "passed",
        "evidence",
        "grader"
      ],
      "type": "object"
    },
    "GraderInfo": {
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/GraderKind"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "GraderKind": {
      "enum": [
        "mechanical",
        "declarative",
        "llm",
        "script",
        "needs_llm",
        "none"
      ],
      "type": "string"
    },
    "GradingSummary": {
      "properties": {
        "failed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pass_rate": {
          "description": "Over the scored assertions only, so an ungradable property cannot drag a\nskill's score down on a runner that simply cannot be observed. `null` when\nnothing was scored at all, because no assertion answered is not the same\nresult as every assertion failed.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "passed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "total"
      ],
      "type": "object"
    }
  },
  "$id": "https://trogonstack.dev/schemas/trg/grading.json.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assertion_results": {
      "items": {
        "$ref": "#/$defs/AssertionGradeResult"
      },
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/GradingSummary"
    }
  },
  "required": [
    "schema_version",
    "assertion_results",
    "summary"
  ],
  "title": "trg skills eval grading",
  "type": "object"
}
