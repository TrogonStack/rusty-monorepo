{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trogonstack.dev/schemas/trg/grading.json.schema.json",
  "title": "trg skills eval grading",
  "type": "object",
  "required": ["schema_version", "assertion_results", "summary"],
  "properties": {
    "schema_version": {
      "const": "trg.skills-eval.grading.v1"
    },
    "assertion_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion_result" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "additionalProperties": true,
  "$defs": {
    "grader_info": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["mechanical", "llm", "script", "needs_llm", "none"]
        },
        "model": { "type": "string" },
        "command": { "type": "string" }
      },
      "additionalProperties": true
    },
    "assertion_result": {
      "type": "object",
      "required": ["passed", "evidence", "grader"],
      "properties": {
        "assertion": { "type": "string" },
        "text": { "type": "string" },
        "passed": { "type": "boolean" },
        "evidence": { "type": "string" },
        "grader": { "$ref": "#/$defs/grader_info" },
        "rationale": { "type": "string" }
      },
      "anyOf": [
        { "required": ["assertion"] },
        { "required": ["text"] }
      ],
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "total", "pass_rate"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  }
}
