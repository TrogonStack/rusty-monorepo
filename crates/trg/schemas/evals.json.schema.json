{
  "$defs": {
    "CaseGrader": {
      "description": "A grader as a case declares it, together with the arm scope that decides\nwhether its result counts toward the score.",
      "oneOf": [
        {
          "properties": {
            "negate": {
              "default": false,
              "type": "boolean"
            },
            "pattern": {
              "$ref": "#/$defs/RegexPattern"
            },
            "target": {
              "allOf": [
                {
                  "$ref": "#/$defs/GradeTarget"
                }
              ],
              "default": "final_text"
            },
            "type": {
              "const": "regex",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pattern"
          ],
          "type": "object"
        },
        {
          "properties": {
            "case": {
              "allOf": [
                {
                  "$ref": "#/$defs/MatchCase"
                }
              ],
              "default": "insensitive"
            },
            "negate": {
              "default": false,
              "type": "boolean"
            },
            "target": {
              "allOf": [
                {
                  "$ref": "#/$defs/GradeTarget"
                }
              ],
              "default": "final_text"
            },
            "text": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "type": {
              "const": "contains",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "path": {
              "$ref": "#/$defs/RelativeSkillPath"
            },
            "type": {
              "const": "file_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "input_match": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RegexPattern"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_calls": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "min_calls": {
              "default": 1,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "tool": {
              "$ref": "#/$defs/ToolName"
            },
            "type": {
              "const": "tool_used",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool"
          ],
          "type": "object"
        },
        {
          "properties": {
            "tools": {
              "items": {
                "$ref": "#/$defs/ToolName"
              },
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "tool_order",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tools"
          ],
          "type": "object"
        },
        {
          "properties": {
            "negate": {
              "default": false,
              "type": "boolean"
            },
            "type": {
              "const": "skill_used",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "criterion": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "type": {
              "const": "llm",
              "type": "string"
            }
          },
          "required": [
            "type",
            "criterion"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "arm": {
          "$ref": "#/$defs/GraderArm"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraderName"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "EvalCase": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_output": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "expected_output_files": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelativeSkillPath"
          },
          "type": "array"
        },
        "grader_hints": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "graders": {
          "items": {
            "$ref": "#/$defs/CaseGrader"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/EvalCaseId"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvalPriority"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "scaffold": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceScaffold"
            },
            {
              "type": "null"
            }
          ],
          "description": "The state this case is asking about, for a case that is not asking about an empty\ndirectory."
        },
        "skill_disclosure": {
          "$ref": "#/$defs/SkillDisclosure"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timeout_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "prompt",
        "expected_output"
      ],
      "type": "object"
    },
    "EvalCaseId": {
      "description": "Non-empty string or non-negative integer",
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "EvalPriority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "GradeTarget": {
      "oneOf": [
        {
          "enum": [
            "final_text",
            "transcript",
            "any_output"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "file": {
              "$ref": "#/$defs/RelativeSkillPath"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "GraderArm": {
      "description": "Which arm of a with-skill versus without-skill comparison a grader is\nallowed to score in.\n\nA check that presupposes the skill can only ever pass where the skill is\npresent, so scoring it would credit the skill for its own premise and widen\nthe reported gap between the arms by exactly the number of such checks.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Let the grader decide: one that presupposes the skill is reported but\nnever scored, and everything else is scored.",
          "type": "string"
        },
        {
          "const": "with_only",
          "description": "Report the result in both arms and score it in neither.",
          "type": "string"
        },
        {
          "const": "both",
          "description": "Score in both arms even though the grader presupposes the skill, which\nis how a \"the skill must not be engaged\" expectation is written.",
          "type": "string"
        }
      ]
    },
    "GraderName": {
      "minLength": 1,
      "type": "string"
    },
    "MatchCase": {
      "enum": [
        "insensitive",
        "sensitive"
      ],
      "type": "string"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "RegexPattern": {
      "format": "regex",
      "minLength": 1,
      "type": "string"
    },
    "RelativeSkillPath": {
      "type": "string"
    },
    "SkillDisclosure": {
      "description": "Whether a case's prompt names the skill that is staged for it.\n\nA prompt that names the skill asks how well a run uses a skill it has already\nbeen handed. It cannot also ask whether the skill's own description wins the\nrun's routing decision, because the prompt made that decision for the run.\nThose are two different questions, so a case has to say which one it asks.",
      "oneOf": [
        {
          "const": "announced",
          "description": "Name the skill, the directory it is staged in, and its description.",
          "type": "string"
        },
        {
          "const": "unannounced",
          "description": "Stage the skill where a listing of the workspace shows it and say nothing\nabout it, so both arms of a comparison get the same prompt and a run has\nto reach for the skill on its own.",
          "type": "string"
        }
      ]
    },
    "ToolName": {
      "type": "string"
    },
    "WorkspaceScaffold": {
      "allOf": [
        {
          "$ref": "#/$defs/RelativeSkillPath"
        }
      ],
      "description": "A script a case runs in its own workspace before any agent starts.\n\nA skill whose work depends on the state of a directory cannot be asked about that work\nin an empty one. A case that reaches for a lockfile, a repository mid-rebase, or a file\nthat is already wrong is asking a question the empty workspace does not contain, and\nwithout a way to say so the case can only be written as if every skill were used on a\nblank slate, which is not how any of them are used.\n\ntrg runs the script itself rather than asking a harness to, which is what keeps the\nstatement portable: the same case puts the same directory in front of every harness,\nand none of them needs a setup mechanism of its own for it to work."
    }
  },
  "$id": "https://trogonstack.dev/schemas/trg/evals.json.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evals": {
      "items": {
        "$ref": "#/$defs/EvalCase"
      },
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "skill_name": {
      "$ref": "#/$defs/NonEmptyString"
    }
  },
  "required": [
    "skill_name",
    "evals"
  ],
  "title": "trg skills eval suite",
  "type": "object"
}
