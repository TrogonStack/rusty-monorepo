{
  "$defs": {
    "EvalCase": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "type": "array"
        },
        "expected_output": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "expected_output_files": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelativeSkillPath"
          },
          "type": "array"
        },
        "grader_hints": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "graders": {
          "items": {
            "$ref": "#/$defs/Grader"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/EvalCaseId"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvalPriority"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timeout_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "prompt",
        "expected_output"
      ],
      "type": "object"
    },
    "EvalCaseId": {
      "description": "Non-empty string or non-negative integer",
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "EvalPriority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "GradeTarget": {
      "oneOf": [
        {
          "enum": [
            "final_text",
            "transcript",
            "any_output"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "file": {
              "$ref": "#/$defs/RelativeSkillPath"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "Grader": {
      "oneOf": [
        {
          "properties": {
            "negate": {
              "default": false,
              "type": "boolean"
            },
            "pattern": {
              "$ref": "#/$defs/RegexPattern"
            },
            "target": {
              "allOf": [
                {
                  "$ref": "#/$defs/GradeTarget"
                }
              ],
              "default": "final_text"
            },
            "type": {
              "const": "regex",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pattern"
          ],
          "type": "object"
        },
        {
          "properties": {
            "case": {
              "allOf": [
                {
                  "$ref": "#/$defs/MatchCase"
                }
              ],
              "default": "insensitive"
            },
            "negate": {
              "default": false,
              "type": "boolean"
            },
            "target": {
              "allOf": [
                {
                  "$ref": "#/$defs/GradeTarget"
                }
              ],
              "default": "final_text"
            },
            "text": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "type": {
              "const": "contains",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "path": {
              "$ref": "#/$defs/RelativeSkillPath"
            },
            "type": {
              "const": "file_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "min_calls": {
              "default": 1,
              "format": "uint",
              "minimum": 1,
              "type": "integer"
            },
            "tool": {
              "$ref": "#/$defs/ToolName"
            },
            "type": {
              "const": "tool_used",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool"
          ],
          "type": "object"
        },
        {
          "properties": {
            "tools": {
              "items": {
                "$ref": "#/$defs/ToolName"
              },
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "tool_order",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tools"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "skill_used",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "criterion": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "type": {
              "const": "llm",
              "type": "string"
            }
          },
          "required": [
            "type",
            "criterion"
          ],
          "type": "object"
        }
      ]
    },
    "MatchCase": {
      "enum": [
        "insensitive",
        "sensitive"
      ],
      "type": "string"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "RegexPattern": {
      "format": "regex",
      "minLength": 1,
      "type": "string"
    },
    "RelativeSkillPath": {
      "type": "string"
    },
    "ToolName": {
      "type": "string"
    }
  },
  "$id": "https://trogonstack.dev/schemas/trg/evals.json.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evals": {
      "items": {
        "$ref": "#/$defs/EvalCase"
      },
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "skill_name": {
      "$ref": "#/$defs/NonEmptyString"
    }
  },
  "required": [
    "skill_name",
    "evals"
  ],
  "title": "trg skills eval suite",
  "type": "object"
}
