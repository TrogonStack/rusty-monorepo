{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trogonstack.dev/schemas/trg/evals.json.schema.json",
  "title": "trg skills eval manifest",
  "type": "object",
  "required": ["skill_name", "evals"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "default": 1
    },
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/eval_case" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "eval_priority": {
      "enum": ["low", "normal", "high", "critical"]
    },
    "eval_case": {
      "type": "object",
      "required": ["id", "prompt", "expected_output"],
      "properties": {
        "id": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "prompt": { "type": "string", "minLength": 1 },
        "expected_output": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "assertions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "priority": { "$ref": "#/$defs/eval_priority" },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1
        },
        "expected_output_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "grader_hints": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
