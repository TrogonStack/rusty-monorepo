{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    }
  ],
  "packages": {
    "crates/trg": {
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='trg')].version"
        }
      ]
    },
    "crates/trogon_dylint_lints": {},
    "crates/trogon_object_id": {
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='trogon_object_id')].version"
        }
      ]
    },
    "crates/trogon_object_id_derive": {
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='trogon_object_id_derive')].version"
        }
      ]
    },
    "crates/trogon_uuid": {
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='trogon_uuid')].version"
        }
      ]
    },
    "crates/trogon_uuid_build": {
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='trogon_uuid_build')].version"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "sentence-case"
    }
  ],
  "tag-separator": "@",
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "release-type": "rust",
  "draft": false,
  "draft-pull-request": false,
  "prerelease": false,
  "pull-request-header": "An automated release has been created for you.",
  "separate-pull-requests": true,
  "signoff": "SHT Bot <61149376+sht-bot@users.noreply.github.com>"
}
